---
interface Props {
  ratio?: string;
  note: string;
  variant?: "light" | "dark";
  class?: string;
}
const { ratio = "4/3", note, variant = "light", class: className = "" } = Astro.props as Props;

const isDark = variant === "dark";
const box = isDark
  ? "border-[var(--hero-rule)] bg-[#131310] text-[var(--hero-rule)]"
  : "border-[var(--rule-strong)] bg-[#eeece5] text-[var(--rule-strong)]";
const text = isDark ? "text-[var(--hero-fg-muted)]" : "text-[var(--fg-muted)]";
---

<div class={className}>
  <div
    class={`relative w-full overflow-hidden border ${box}`}
    style={`aspect-ratio: ${ratio}; background-image: repeating-linear-gradient(135deg, currentColor 0, currentColor 1px, transparent 1px, transparent 14px);`}
  >
    <span class={`absolute inset-0 flex items-center justify-center px-6 text-center text-[12px] font-mono ${text}`}>
      준비 중 · 실제 화면/다이어그램으로 교체 예정
    </span>
  </div>
  <p class={`mt-3 font-mono text-[12px] leading-snug ${text}`}>{note}</p>
</div>

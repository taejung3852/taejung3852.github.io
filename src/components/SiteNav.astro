---
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
interface Props { variant?: 'dark' | 'light' }
---
<a class="skip-link" href="#main">본문 바로가기</a>
<header class="site-header"><nav class="shell nav-inner" aria-label="주 내비게이션">
 <a href="/" class="wordmark">박태정</a>
 <div class="nav-actions">
  <div class="nav-links" id="nav-links">
   <a href="/#projects">프로젝트</a><a href="/#about">소개</a>
   <a href="/documents/taejung-resume.pdf" download>이력서</a>
  </div>
  <ThemeToggle /><button class="menu-toggle" aria-label="메뉴" aria-expanded="false" aria-controls="nav-links"><Icon name="list" /></button>
 </div>
</nav></header>
<script>
 const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
 const links = document.querySelector<HTMLElement>('.nav-links');
 function close() { menu?.setAttribute('aria-expanded','false'); links?.classList.remove('is-open'); }
 menu?.addEventListener('click', () => { const open = menu.getAttribute('aria-expanded') !== 'true'; menu.setAttribute('aria-expanded',String(open)); links?.classList.toggle('is-open',open); });
 links?.querySelectorAll('a').forEach(link => link.addEventListener('click',close));
 document.addEventListener('keydown',event => { if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') { close(); menu.focus(); } });
</script>

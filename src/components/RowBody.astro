---
interface Props {
  oneLiner: string;
  role: string;
  capabilities: string[];
}
const { oneLiner, role, capabilities } = Astro.props as Props;
---

<div class="mt-4 max-w-[52ch]">
  <p class="text-[16px] leading-relaxed text-[var(--fg)]">{oneLiner}</p>
  <p class="mt-3 text-[13.5px] leading-relaxed text-[var(--fg-muted)]">{role}</p>
  <p class="mt-4 font-mono text-[11.5px] tracking-tight text-[var(--fg-muted)]">
    {capabilities.join(" · ")}
  </p>
</div>

---
import gsapSource from 'gsap/dist/gsap.min.js?raw';
import triggerSource from 'gsap/dist/ScrollTrigger.min.js?raw';
---
<script is:inline set:html={gsapSource + '\n' + triggerSource} />
<script is:inline>
(() => {
 const { gsap, ScrollTrigger } = window;
 if (!gsap || !ScrollTrigger) return;
 gsap.registerPlugin(ScrollTrigger);
 let media;
 function setup() {
   media?.revert();
   if (location.hash === '#fowoco') return;
   media = gsap.matchMedia();
   media.add('(prefers-reduced-motion: no-preference)', () => {
     gsap.fromTo('.reveal-copy span', { opacity: .3 }, {
       opacity: 1, stagger: .1, ease: 'none',
       scrollTrigger: { trigger: '.reveal-copy', start: 'top 85%', end: 'bottom 55%', scrub: .5 }
     });
   });
   media.add('(min-width: 1200px) and (prefers-reduced-motion: no-preference)', () => {
     ScrollTrigger.create({ trigger: '.projects-heading', start: 'top 96px',
       endTrigger: '.project-list', end: 'bottom 65%', pin: true, pinSpacing: false });
   });
   ScrollTrigger.refresh();
 }
 document.fonts.ready.then(setup);
 addEventListener('hashchange', () => requestAnimationFrame(setup));
 document.querySelectorAll('.project-visual').forEach(el => el.addEventListener('toggle', () => ScrollTrigger.refresh()));
})();
</script>

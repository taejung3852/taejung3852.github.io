---
import VisualPlaceholder from "./VisualPlaceholder.astro";
import RowHeading from "./RowHeading.astro";
import RowBody from "./RowBody.astro";

interface Props {
  index: string;
  name: string;
  oneLiner: string;
  role: string;
  capabilities: string[];
  href?: string;
  ratio: string;
  note: string;
  layout: "split-right" | "split-left" | "stack";
}

const { index, name, oneLiner, role, capabilities, href, ratio, note, layout } = Astro.props as Props;

const Tag = href ? "a" : "div";
const linkProps = href ? { href } : {};
---

<article class="border-t border-[var(--rule)] py-14 first:border-t-0 md:py-20">
  <Tag
    {...linkProps}
    class={`group grid grid-cols-1 gap-8 md:gap-12 ${
      layout === "stack" ? "" : "md:grid-cols-12 md:items-center"
    }`}
  >
    {
      layout === "stack" ? (
        <>
          <VisualPlaceholder ratio={ratio} note={note} class="w-full max-w-[var(--w-media)]" />
          <div class="max-w-[var(--w-copy)]">
            <RowHeading index={index} name={name} href={href} />
            <RowBody oneLiner={oneLiner} role={role} capabilities={capabilities} />
          </div>
        </>
      ) : layout === "split-left" ? (
        <>
          <div class="md:order-1 md:col-span-5">
            <VisualPlaceholder ratio={ratio} note={note} />
          </div>
          <div class="md:order-2 md:col-span-7">
            <RowHeading index={index} name={name} href={href} />
            <RowBody oneLiner={oneLiner} role={role} capabilities={capabilities} />
          </div>
        </>
      ) : (
        <>
          <div class="md:col-span-7">
            <RowHeading index={index} name={name} href={href} />
            <RowBody oneLiner={oneLiner} role={role} capabilities={capabilities} />
          </div>
          <div class="md:col-span-5">
            <VisualPlaceholder ratio={ratio} note={note} />
          </div>
        </>
      )
    }
  </Tag>
</article>

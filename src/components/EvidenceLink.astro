---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props as Props;
---

<a
  href={href}
  target="_blank"
  rel="noreferrer"
  class="inline-flex items-center gap-1 border-b border-[var(--accent)]/40 font-mono text-[12.5px] text-[var(--accent)] transition-colors hover:border-[var(--accent)]"
>
  {label}
  <span aria-hidden="true">↗</span>
</a>
